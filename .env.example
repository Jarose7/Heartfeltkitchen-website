# Copy this file to .env for local testing. Never commit the real .env file.
DATABASE_URL=postgresql://user:password@localhost:5432/heartfeltkitchen
PORT=3000

# Admin panel (single login, no multi-user accounts). Set these as real
# environment variables in Render's dashboard, not in this file or git.
# Generate ADMIN_PASSWORD_HASH by running (after `npm install`):
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD_HERE', 10))"
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=becca
ADMIN_PASSWORD_HASH=paste-the-generated-bcrypt-hash-here
