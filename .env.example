# Copy this file to .env for local testing. Never commit the real .env file.
DATABASE_URL=postgresql://user:password@localhost:5432/heartfeltkitchen
PORT=3000

# Admin panel (single login, no multi-user accounts). Set these as real
# environment variables in Render's dashboard, not in this file or git.
# Generate ADMIN_PASSWORD_HASH by running (after `npm install`):
#   node -e "console.log(require('bcryptjs').hashSync('YOUR_PASSWORD_HERE', 10))"
SESSION_SECRET=change-this-to-a-long-random-string
ADMIN_USERNAME=becca
ADMIN_PASSWORD_HASH=paste-the-generated-bcrypt-hash-here

# Optional: pushes new inquiries into Becca's Flodesk account (as a
# subscriber tagged into a "Website Inquiries" segment). If left unset,
# inquiries just save to the database as normal — nothing breaks either
# way. Get this from Becca's Flodesk account: My Account > Integrations >
# API keys > Create API key. Paid Flodesk plan required.
FLODESK_API_KEY=

# Optional: emails jackroseblue@gmail.com and heartfeltkitchen@gmail.com
# with the full inquiry every time someone submits the form. If unset,
# inquiries still save to the database as normal — nothing breaks either
# way. Uses Brevo's SMTP relay. BREVO_SMTP_LOGIN and BREVO_SMTP_KEY come
# from Brevo: Transactional > Settings > SMTP relay > Generate a new SMTP
# key (this is NOT the API key used elsewhere in Brevo). BREVO_FROM_EMAIL
# is the "from" address and must be a verified sender in Brevo (Senders,
# Domains & Dedicated IPs > Senders) before Brevo will relay mail from it.
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_FROM_EMAIL=
